# SID 1000002 — HTTP URI containing .exe (IDS: alert only)
# Detects: malware downloader / dropper stage fetching an executable over HTTP
# ATT&CK: T1105 - Ingress Tool Transfer
# Limitation: HTTP (port 80) only, blind to HTTPS
alert tcp any any -> any 80 (msg:"HTTP URI contains .exe"; flow:established,to_server; content:"|2e|exe"; nocase; http_uri; sid:1000002; rev:2;)
